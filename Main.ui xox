-- ===== HELPERS =====
local function isBasePart(inst) return typeof(inst) == "Instance" and inst:IsA("BasePart") end

local function ensurePrimary(model)
    if model and model:IsA("Model") then
        if not isBasePart(model.PrimaryPart) then
            local bp = model:FindFirstChildWhichIsA("BasePart")
            if bp then model.PrimaryPart = bp end
        end
        return model.PrimaryPart
    end
end

local function prepSkinModel(skin, isKnife)
    for _, d in ipairs(skin:GetDescendants()) do
        if d:IsA("BasePart") then
            d.CanCollide = false; d.Anchored = false; d.Massless = true
            d.Transparency = math.clamp(d.Transparency, 0, 1)
        elseif d:IsA("MeshPart") then
            local sa = d:FindFirstChildOfClass("SurfaceAppearance")
            if sa then sa:Destroy() end
            if d.TextureID == "" then
                local n = d.Name:lower()
                if n:find("box") or n:find("cube") or n:find("part") or n:find("hit") then
                    d.Transparency = 1
                end
            end
        end
    end
end

local function weldTo(handle, part)
    if isBasePart(handle) and isBasePart(part) then
        local w = Instance.new("WeldConstraint")
        w.Part0 = handle; w.Part1 = part; w.Parent = part
        return w
    end
end

local function getWrapSkin(toolName, skinName, timeout)
    local wraps = RS2:WaitForChild("Wraps", timeout or 5)
    if not wraps then return nil end
    local folder = wraps:WaitForChild("[" .. toolName .. "]", timeout or 5)
    if not folder or skinName == "" then return nil end
    return folder:WaitForChild(skinName, timeout or 5)
end

local function applySkinToTool(tool, skinModel)
    if not tool or not skinModel then return end
    local handle = tool:FindFirstChild("Handle")
    if not isBasePart(handle) then return end
    local old = tool:FindFirstChild("SkinModel")
    if old then old:Destroy() end
    local clone = skinModel:Clone()
    clone.Name = "SkinModel"
    if not isBasePart(ensurePrimary(clone)) then return end
    prepSkinModel(clone, tool.Name:find("Knife") and true or false)
    clone.Parent = tool
    clone:PivotTo(handle.CFrame)
    for _, p in ipairs(clone:GetDescendants()) do
        if p:IsA("BasePart") then weldTo(handle, p) end
    end
    handle.Transparency = 1
end

local function applyToolSkin(tool)
    if not SkinState.enabled or not tool or not tool:IsA("Tool") then return end
    local name = tool.Name:match("^%[(.+)%]$")
    if not name then return end
    local skin = SkinState[name]
    if name == "Knife" then skin = SkinState.special.Knife end
    if not skin or skin == "" then
        local old = tool:FindFirstChild("SkinModel")
        if old then old:Destroy() end
        local h = tool:FindFirstChild("Handle")
        if isBasePart(h) then h.Transparency = 0 end
        return
    end
    local src
    if name == "Knife" then
        local knives = RS2:FindFirstChild("Knives")
        src = knives and knives:FindFirstChild(skin)
    else
        src = getWrapSkin(name, skin, 5)
    end
    if src then applySkinToTool(tool, src) end
end

local function scanCharacter(char)
    if not char then return end
    for _, c in ipairs(char:GetChildren()) do
        if c:IsA("Tool") then task.defer(function() applyToolSkin(c) end) end
    end
    char.ChildAdded:Connect(function(c)
        if c:IsA("Tool") then task.defer(function() applyToolSkin(c) end) end
    end)
end

if LP.Character then task.spawn(scanCharacter, LP.Character) end
LP.CharacterAdded:Connect(function(c) task.wait(1); scanCharacter(c) end)

-- ===== BULLET BEAMS =====
local function applyBulletBeams()
    if not BulletBeamsEnabled then return end
    local df = LP:FindFirstChild("DataFolder")
    if not df then return end
    local inv = df:FindFirstChild("InventoryData")
    if not inv then return end
    local equipped = df:FindFirstChild("EquippedBulletBeams")
    local ib = inv:FindFirstChild("BulletBeams")
    if ib and ib:IsA("StringValue") then
        local data = {}
        if ib.Value ~= "" then pcall(function() data = HS:JSONDecode(ib.Value) end) end
        if type(data) ~= "table" then data = {} end
        for _, hash in pairs(BEAM_HASH) do
            data[hash] = { Name = BulletChanger.DoubleBarrel }
        end
        ib.Value = HS:JSONEncode(data)
    end
    if equipped and equipped:IsA("StringValue") then
        equipped.Value = HS:JSONEncode({
            ["[DoubleBarrel]"] = BEAM_HASH.DoubleBarrel,
            ["[Revolver]"] = BEAM_HASH.Revolver,
            ["[TacticalShotgun]"] = BEAM_HASH.TacticalShotgun,
            ["[SMG]"] = BEAM_HASH.SMG,
            ["[Shotgun]"] = BEAM_HASH.Shotgun
        })
    end
end

