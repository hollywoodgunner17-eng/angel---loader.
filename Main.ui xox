local function toggle(parent, label, def, cb)
    local r = Instance.new("Frame")
    r.Size = UDim2.new(1, 0, 0, 42)
    r.BackgroundTransparency = 1
    r.ZIndex = 3
    r.Parent = parent
    local t = Instance.new("TextLabel")
    t.Size = UDim2.new(1, -72, 1, 0)
    t.BackgroundTransparency = 1
    t.Text = label
    t.Font = Enum.Font.GothamMedium
    t.TextSize = 14
    t.TextColor3 = T.Tx
    t.TextXAlignment = Enum.TextXAlignment.Left
    t.ZIndex = 3
    t.Parent = r
    local sw = Instance.new("Frame")
    sw.Size = UDim2.new(0, 54, 0, 30)
    sw.Position = UDim2.new(1, -54, 0.5, -15)
    sw.BackgroundColor3 = def and T.On or T.Off
    sw.BackgroundTransparency = 0.25
    sw.BorderSizePixel = 0
    sw.ZIndex = 3
    sw.Parent = r
    Instance.new("UICorner", sw).CornerRadius = UDim.new(1, 0)
    local swGlow = Instance.new("UIStroke", sw)
    swGlow.Color = T.AG; swGlow.Thickness = 3; swGlow.Transparency = def and 0.5 or 1
    local k = Instance.new("Frame")
    k.Size = UDim2.new(0, 24, 0, 24)
    k.Position = def and UDim2.new(1, -28, 0.5, -12) or UDim2.new(0, 4, 0.5, -12)
    k.BackgroundColor3 = T.Tx
    k.BackgroundTransparency = 0.15
    k.BorderSizePixel = 0
    k.ZIndex = 3
    k.Parent = sw
    Instance.new("UICorner", k).CornerRadius = UDim.new(1, 0)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 1, 0)
    btn.BackgroundTransparency = 1
    btn.Text = ""
    btn.ZIndex = 6
    btn.Parent = r
    local state = def
    btn.MouseButton1Click:Connect(function()
        state = not state
        TS:Create(sw, TweenInfo.new(0.18), { BackgroundColor3 = state and T.On or T.Off, BackgroundTransparency = 0.25 }):Play()
        TS:Create(swGlow, TweenInfo.new(0.18), { Transparency = state and 0.5 or 1 }):Play()
        TS:Create(k, TweenInfo.new(0.18), { Position = state and UDim2.new(1, -28, 0.5, -12) or UDim2.new(0, 4, 0.5, -12) }):Play()
        cb(state)
    end)
end

