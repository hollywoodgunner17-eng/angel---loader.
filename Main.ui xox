    while batLayer.Parent do
        local dt = task.wait(0.03)
        if not main.Visible then
            task.wait(0.1)
        else
            local w, h = main.AbsoluteSize.X, main.AbsoluteSize.Y
            for _, b in ipairs(bats) do
                local px = b.x * w + b.vx * w * dt
                local py = b.y * h + b.vy * h * dt
                if px < 0 or px > w - b.size then b.vx = -b.vx; px = math.clamp(px, 0, w - b.size) end
                if py < 0 or py > h - b.size then b.vy = -b.vy; py = math.clamp(py, 0, h - b.size) end
                b.x = px / w; b.y = py / h
                b.obj.Position = UDim2.new(0, px, 0, py)
                b.obj.Rotation = math.sin(tick() * 3 + b.size) * 14
            end
        end
