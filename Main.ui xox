local skinSec = section("Skinchanger", "🔪")
toggle(skinSec, "Enable Skin Changer", false, function(v)
    SkinState.enabled = v
    if v then
        local ch = LP.Character
        if ch then
            for _, x in ipairs(ch:GetChildren()) do
                if x:IsA("Tool") then task.defer(function() applyToolSkin(x) end) end
            end
        end
    else
        local ch = LP.Character
        if ch then
            for _, x in ipairs(ch:GetChildren()) do
                if x:IsA("Tool") then
                    local sm = x:FindFirstChild("SkinModel")
                    if sm then sm:Destroy() end
                    local h = x:FindFirstChild("Handle")
                    if isBasePart(h) then h.Transparency = 0 end
                end
            end
        end
    end
end)

local function getWrapList(toolName)
    local l = { "None" }
    local wraps = RS2:FindFirstChild("Wraps")
    local f = wraps and wraps:FindFirstChild("[" .. toolName .. "]")
    if f then for _, x in ipairs(f:GetChildren()) do table.insert(l, x.Name) end end
    return l
end
local function getKnifeList()
    local l = { "None" }
    local knives = RS2:FindFirstChild("Knives")
    if knives then for _, x in ipairs(knives:GetChildren()) do table.insert(l, x.Name) end end
    return l
end

for _, toolName in ipairs({ "DoubleBarrel", "Revolver", "TacticalShotgun", "SMG", "Shotgun", "Silencer" }) do
    dropdown(skinSec, toolName, getWrapList(toolName), SkinState[toolName] ~= "" and SkinState[toolName] or "None", function(v)
        SkinState[toolName] = (v == "None") and "" or v
        local ch = LP.Character
        if ch then
            local t = ch:FindFirstChild("[" .. toolName .. "]")
            if t then task.defer(function() applyToolSkin(t) end) end
        end
    end)
end
dropdown(skinSec, "Knife", getKnifeList(), SkinState.special.Knife ~= "" and SkinState.special.Knife or "None", function(v)
    SkinState.special.Knife = (v == "None") and "" or v
    local ch = LP.Character
    if ch then
        local k = ch:FindFirstChild("[Knife]")
        if k then task.defer(function() applyToolSkin(k) end) end
    end
end)

